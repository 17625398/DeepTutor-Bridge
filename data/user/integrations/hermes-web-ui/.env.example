# hermes-web-ui 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# ============================
# 分离部署配置
# ============================

# 远程 hermes-agent 地址（192.168.0.39 上的 gateway 端口，默认 8642）
# 设置此项后，Web UI 将连接到远程 agent，不再启动本地 gateway
HERMES_GATEWAY_URL=http://192.168.0.39:8642

# ============================
# 其他可选配置
# ============================

# Web UI 数据目录
# HERMES_WEB_UI_HOME=/path/to/hermes-web-ui-data

# Web UI 服务端口
# PORT=8648

# 认证 Token（如果 agent 需要）
# AUTH_TOKEN=your-token-here

# 上传目录
# UPLOAD_DIR=/path/to/uploads

# Gateway 主机（本地部署时）
# GATEWAY_HOST=127.0.0.1

# 关闭 Web UI 时是否停止 gateway（0=不停止，1=停止）
# HERMES_WEB_UI_STOP_GATEWAYS_ON_SHUTDOWN=1
